# Copy to your environment / GitLab CI variables. Never commit real values.
DATABASE_URL=jdbc:postgresql://localhost:5432/vyra_assets
DATABASE_PASSWORD=
MAIL_USERNAME=
MAIL_PASSWORD=            # Gmail app password
CRYPTO_SECRET_KEY=        # AES key, exactly 16/24/32 chars; changing it breaks decryption of existing encrypted data
# Optional brute-force protection tuning (defaults shown)
# VYRA_PIN_MAX_ATTEMPTS=5
# VYRA_PIN_LOCK_MINUTES=15
# VYRA_OTP_LOCK_MINUTES=10
# VYRA_OTP_RESEND_COOLDOWN_SECONDS=60
# VYRA_ADMIN_MAX_ATTEMPTS=5
# VYRA_ADMIN_LOCK_MINUTES=15
# VYRA_RATE_LIMIT_ENABLED=true
# FORWARD_HEADERS_STRATEGY=native
# VYRA_RATE_LIMIT_STORE=database
# DB_LOCK_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=30000
VYRA_ADMIN_SEED_PASSWORD=
