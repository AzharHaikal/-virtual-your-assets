# Copy to your environment / GitLab CI variables. Never commit real values.
# sit / uat / prod: picks application-<profile>.yaml (empty = local development defaults)
SPRING_PROFILES_ACTIVE=
DATABASE_URL=jdbc:postgresql://localhost:5432/vyra_assets
DATABASE_PASSWORD=
MAIL_USERNAME=
MAIL_PASSWORD=            # Gmail app password
CRYPTO_SECRET_KEY=        # AES key, exactly 16/24/32 chars; changing it breaks decryption of existing encrypted data
# Optional brute-force protection tuning (defaults shown)
# VYRA_PIN_MAX_ATTEMPTS=5
# VYRA_PIN_LOCK_MINUTES=15
# VYRA_OTP_LOCK_MINUTES=10
# VYRA_OTP_RESEND_COOLDOWN_SECONDS=60
# VYRA_ADMIN_MAX_ATTEMPTS=5
# VYRA_ADMIN_LOCK_MINUTES=15
# VYRA_RATE_LIMIT_ENABLED=true
# FORWARD_HEADERS_STRATEGY=native
# VYRA_RATE_LIMIT_STORE=database
# DB_LOCK_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=30000
# OpenAPI / Swagger UI at /swagger-ui.html (keep false in production)
# VYRA_API_DOCS_ENABLED=false
# Time zones (defaults shown). LEGACY_* are only read once, by migration V7.
# VYRA_DEFAULT_TIMEZONE=Asia/Jakarta
# VYRA_LEGACY_SERVER_TIMEZONE=Asia/Jakarta
# VYRA_LEGACY_CLIENT_TIMEZONE=Asia/Jakarta
# Password of the first SUPER_ADMIN (created on the first start of an empty database). Required on
# sit/uat/prod: at least 12 characters and not the built-in default, or the first start fails.
VYRA_ADMIN_SEED_PASSWORD=
# Browser origins allowed by CORS (portal + landing page), comma-separated. Empty/unset = any origin.
# VYRA_CORS_ALLOWED_ORIGINS=https://<portal-site>
